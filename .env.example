# Google Cloud Configuration for Project Kisan
# Copy this file to .env and fill in your actual values

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-project-id-here
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# Vertex AI Configuration
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL_NAME=gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-1.5-pro-vision

# Speech and Language Configuration
DEFAULT_LANGUAGE=kn-IN
SUPPORTED_LANGUAGES=kn-IN,hi-IN,en-US

# Market Data APIs
AGMARKNET_API_KEY=your-agmarknet-api-key
ENAM_API_KEY=your-enam-api-key

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=sqlite:///kisan.db

# File Upload Configuration
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB

# Voice Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_ENCODING=WEBM_OPUS

# Model Configuration
MAX_IMAGE_SIZE=10485760  # 10MB
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,webp

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/kisan.log

# External APIs
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# Security Configuration
SESSION_TIMEOUT=3600  # 1 hour
PASSWORD_MIN_LENGTH=6
ENABLE_CSRF_PROTECTION=True

# Performance Configuration
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30

# Features Toggle
ENABLE_VOICE_INPUT=True
ENABLE_VOICE_OUTPUT=True
ENABLE_OFFLINE_MODE=True
ENABLE_KANNADA_SUPPORT=True
ENABLE_MARKET_ANALYSIS=True
ENABLE_CROP_DIAGNOSIS=True
ENABLE_SCHEME_NAVIGATOR=True

# Regional Configuration
DEFAULT_STATE=Karnataka
DEFAULT_DISTRICT=Bangalore Rural
SUPPORTED_CROPS=rice,wheat,sugarcane,cotton,tomato,potato,onion,maize

# Mobile App Configuration
PWA_NAME=Kisan+ AI Assistant
PWA_SHORT_NAME=Kisan+
PWA_DESCRIPTION=AI-Powered Farming Assistant for Indian Farmers
PWA_THEME_COLOR=#22c55e
PWA_BACKGROUND_COLOR=#ffffff
